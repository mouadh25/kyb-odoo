<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <!-- Odoo 17, 18, 19, 20 Partner Autocomplete Dropdown Option Override -->
    <t t-inherit="partner_autocomplete.DropdownOption" t-inherit-mode="extension" owl="1">
        <xpath expr="//div/div" position="after">
            <div style="flex-shrink: 0; margin-left: auto; text-align: right; padding-left: 12px;">
                <t t-if="option.data and option.data.statut_badge_style">
                    <span t-att-style="option.data.statut_badge_style" t-out="option.data.statut_badge_clean or option.data.statut_label"/>
                </t>
                <t t-elif="option.statut_badge_style">
                    <span t-att-style="option.statut_badge_style" t-out="option.statut_badge_clean or option.statut_label"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>
