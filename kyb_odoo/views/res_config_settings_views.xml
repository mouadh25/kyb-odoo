<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_kyb" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.kyb</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="KYB Compliance" string="KYB Compliance" data-key="kyb_odoo">
                    <h2>KYB Corporate Identity &amp; Fiscal Verification</h2>
                    <div class="row mt16 o_settings_container" id="kyb_settings_block">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">KYB (by Digidev) Credentials</span>
                                <div class="text-muted">Configure your KYB secret API key (hosted locally on Algérie Télécom Cloud).</div>
                                <div class="content-group mt16">
                                    <div class="row mt8">
                                        <label for="kyb_api_key" class="col-lg-3 o_light_label" string="API Key"/>
                                        <field name="kyb_api_key" password="True" placeholder="sk_live_... ou sk_test_kyb_sandbox_key_001"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="kyb_base_url" class="col-lg-3 o_light_label" string="Gateway URL"/>
                                        <field name="kyb_base_url" placeholder="https://kyb.digidevagency.dz"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="kyb_sovereign_autocomplete"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="kyb_sovereign_autocomplete" string="CNRC Autocomplete"/>
                                <div class="text-muted">Remplace la recherche d'entreprises internationale par le Registre National du Commerce (CNRC) via l'API KYB.</div>
                                <div class="content-group mt16">
                                    <div class="mt8">
                                        <field name="kyb_allow_worldwide_fallback" class="oe_inline"/>
                                        <label for="kyb_allow_worldwide_fallback" string="Autoriser la recherche mondiale de secours" class="oe_inline"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="kyb_autocomplete_filter" string="Filtre Statut" class="col-lg-4 o_light_label"/>
                                        <field name="kyb_autocomplete_filter"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="kyb_autocomplete_limit" string="Max Résultats" class="col-lg-4 o_light_label"/>
                                        <field name="kyb_autocomplete_limit" class="oe_inline"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Détection des Doublons Fiscaux (NIF)</span>
                                <div class="text-muted">Avertit ou bloque lors de la saisie d'un NIF déjà existant sur une autre fiche contact.</div>
                                <div class="content-group mt16">
                                    <field name="kyb_duplicate_nif_policy"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="kyb_invoice_audit_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="kyb_invoice_audit_enabled" string="Temporal Invoice Compliance &amp; Blocking Policy"/>
                                <div class="text-muted">Contrôle réglementaire des factures d'achat (Art. 169 &amp; 176 CIDTA / Art. 30 CTCA) et ventes (Art. 183 ter CIDTA).</div>
                                <div class="content-group mt16">
                                    <div class="row mt8">
                                        <label for="kyb_invoice_blocking_policy" class="col-lg-4 o_light_label" string="Achats (Radié)"/>
                                        <field name="kyb_invoice_blocking_policy"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="kyb_customer_invoice_policy" class="col-lg-4 o_light_label" string="Ventes (Radié)"/>
                                        <field name="kyb_customer_invoice_policy"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="kyb_unverified_partner_policy" class="col-lg-4 o_light_label" string="Non Vérifié"/>
                                        <field name="kyb_unverified_partner_policy"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Gouvernance des Mises à Jour</span>
                                <div class="text-muted">Contrôle de version certifiée (Loi 25-11) et mise à jour en 1 clic.</div>
                                <div class="content-group mt16">
                                    <div class="row mt8">
                                        <label for="kyb_installed_version" class="col-lg-4 o_light_label" string="Version Active"/>
                                        <field name="kyb_installed_version" readonly="1"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="kyb_latest_version" class="col-lg-4 o_light_label" string="Dernière Version"/>
                                        <field name="kyb_latest_version" readonly="1"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="kyb_update_policy" class="col-lg-4 o_light_label" string="Déploiement"/>
                                        <field name="kyb_update_policy" widget="radio"/>
                                    </div>
                                    <div class="mt16">
                                        <button name="action_check_kyb_update" type="object" string="Vérifier Disponibilité" class="btn btn-secondary btn-sm" icon="fa-refresh"/>
                                        <button name="action_upgrade_kyb_module" type="object" string="Mettre à jour (1-Clic)" class="btn btn-primary btn-sm" icon="fa-download"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="kyb_eom_auto_audit"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="kyb_eom_auto_audit" string="End-of-Month Global Audit (G50 Safety Net)"/>
                                <div class="text-muted">Automatically audit all current month vendor bills before statutory tax filing.</div>
                                <div class="content-group mt16">
                                    <div class="row mt8">
                                        <label for="kyb_eom_audit_day" class="col-lg-4 o_light_label" string="Jour du mois"/>
                                        <field name="kyb_eom_audit_day"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_kyb_configuration" model="ir.actions.act_window">
        <field name="name">KYB Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module' : 'kyb_odoo'}</field>
    </record>
</odoo>
