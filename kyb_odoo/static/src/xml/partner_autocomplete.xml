<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <!-- Odoo 16 Partner Autocomplete Dropdown Option Override -->
    <t t-inherit="partner_autocomplete.CharFieldDropdownOption" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_partner_autocomplete_info')]" position="after">
            <div style="flex-shrink: 0; margin-left: auto; text-align: right; padding-left: 12px;">
                <t t-if="option.data and option.data.statut_badge_style">
                    <span t-att-style="option.data.statut_badge_style" t-esc="option.data.statut_badge_clean or option.data.statut_label"/>
                </t>
                <t t-elif="option.statut_badge_style">
                    <span t-att-style="option.statut_badge_style" t-esc="option.data.statut_badge_clean or option.data.statut_label"/>
                </t>
            </div>
        </xpath>
    </t>
</templates>
