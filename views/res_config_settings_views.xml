<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_kyb" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.kyb</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="KYB Verification" string="KYB Sovereign Verification" data-key="kyb">
                    <h2>KYB Sovereign Corporate Identity &amp; Fiscal Verification</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Sovereign API Credentials</span>
                                <div class="text-muted">
                                    Configure your KYB secret API key (Law 25-11 compliant, hosted on Algérie Télécom Sovereign Cloud).
                                </div>
                                <div class="content-group mt8">
                                    <div class="row mt4">
                                        <label for="kyb_api_key" class="col-lg-3 o_light_label" string="API Key"/>
                                        <field name="kyb_api_key" password="True" placeholder="sk_live_... ou sk_test_conforme_sandbox_key_001"/>
                                    </div>
                                    <div class="row mt4">
                                        <label for="kyb_base_url" class="col-lg-3 o_light_label" string="Gateway URL"/>
                                        <field name="kyb_base_url" placeholder="https://kyb.digidevagency.dz"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_kyb_configuration" model="ir.actions.act_window">
        <field name="name">KYB Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'kyb'}</field>
    </record>
</odoo>
