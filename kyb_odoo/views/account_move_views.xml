<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─────────────── Invoice Form: Temporal Compliance ─────────────── -->
    <record id="view_move_form_kyb" model="ir.ui.view">
        <field name="name">account.move.form.kyb</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Header button to verify temporal compliance -->
            <xpath expr="//header" position="inside">
                <button name="action_verify_kyb_compliance"
                        type="object"
                        string="Audit KYB Compliance"
                        class="btn btn-secondary"
                        icon="fa-shield"/>
            </xpath>

            <!-- Status badge next to partner -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="kyb_compliance_status"
                       widget="badge"
                       decoration-success="kyb_compliance_status == 'compliant'"
                       decoration-danger="kyb_compliance_status == 'non_compliant'"
                       decoration-warning="kyb_compliance_status == 'warning'"
                       decoration-muted="kyb_compliance_status == 'unverified'"/>
            </xpath>

            <!-- Dedicated Permanent Tab: Audit de Statut & Conformité KYB -->
            <xpath expr="//notebook" position="inside">
                <page string="Conformité &amp; Statut Registre KYB" name="kyb_audit_tab">
                    <div class="alert alert-info d-flex justify-content-between align-items-center mb-3" role="alert">
                        <div>
                            <strong>Audit Temporel KYB</strong> — Vérification du statut officiel au registre du commerce à la date d'émission (réf. Art. 169 &amp; 176 CIDTA / Art. 30 CTCA).
                        </div>
                        <button name="action_verify_kyb_compliance"
                                type="object"
                                string="Auditer la Facture"
                                class="btn btn-primary btn-sm"
                                icon="fa-shield"/>
                    </div>

                    <group>
                        <group string="Statut &amp; Situation Registre">
                            <field name="kyb_compliance_status" widget="badge"
                                   decoration-success="kyb_compliance_status == 'compliant'"
                                   decoration-danger="kyb_compliance_status == 'non_compliant'"
                                   decoration-warning="kyb_compliance_status == 'warning'"
                                   decoration-muted="kyb_compliance_status == 'unverified'"/>
                            <field name="kyb_tax_deductible" string="Fournisseur Actif" widget="boolean_toggle"/>
                            <field name="kyb_audit_date"/>
                            <field name="kyb_compliance_message"/>
                        </group>
                        <group string="Références Légales &amp; Situation Fournisseur">
                            <field name="kyb_vendor_statut_cnrc" widget="badge"
                                   decoration-success="kyb_vendor_statut_cnrc == 'ACTIF'"
                                   decoration-danger="kyb_vendor_statut_cnrc == 'RADIE'"
                                   decoration-warning="kyb_vendor_statut_cnrc == 'SUSPENDU'"/>
                            <field name="kyb_vendor_forme_juridique"/>
                            <field name="kyb_vendor_nif"/>
                            <field name="kyb_vendor_rc"/>
                            <field name="kyb_vendor_date_radiation"/>
                        </group>
                    </group>

                    <div class="mt-3">
                        <button name="action_verify_kyb_compliance"
                                type="object"
                                string="Vérifier Statut Fournisseur (KYB)"
                                class="btn btn-outline-primary"
                                icon="fa-shield"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ─────────────── Invoice Tree: Status Column ───────────────────── -->
    <record id="view_invoice_tree_kyb" model="ir.ui.view">
        <field name="name">account.invoice.tree.kyb</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="kyb_compliance_status"
                       widget="badge"
                       decoration-success="kyb_compliance_status == 'compliant'"
                       decoration-danger="kyb_compliance_status == 'non_compliant'"
                       decoration-warning="kyb_compliance_status == 'warning'"
                       decoration-muted="kyb_compliance_status == 'unverified'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ─────────────── Server Action: Bulk Compliance Audit ───────────── -->
    <record id="action_bulk_verify_kyb_compliance" model="ir.actions.server">
        <field name="name">Audit KYB Compliance (Bulk)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_verify_kyb_compliance()
        </field>
    </record>

</odoo>
