<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <!-- Odoo 14 & 15 Legacy QWeb Partner Autocomplete Dropdown Extension -->
    <t t-extend="partner_autocomplete.dropdown">
        <t t-jquery=".o_partner_autocomplete_info" t-operation="after">
            <div style="flex-shrink: 0; margin-left: auto; text-align: right; padding-left: 12px;">
                <t t-if="info['statut_badge_style']">
                    <span t-att-style="info['statut_badge_style']"><t t-esc="info['statut_badge_clean'] or info['statut_label']"/></span>
                </t>
            </div>
        </t>
    </t>
</templates>
